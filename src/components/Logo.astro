---
// SwingCraft4J mark: an S hanging inside a hexagon frame, its tips joining
// the frame like a swing. Drawn with currentColor so it follows the theme.
// Standalone copies: public/logo.svg and public/favicon.svg.

interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="5"
  stroke-linejoin="round"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d="M32 5l23.38 13.5v27L32 59 8.62 45.5v-27z"></path>
  <path d="M48.6 14.6L41 19H28.5a6.5 6.5 0 0 0 0 13h7a6.5 6.5 0 0 1 0 13H23l-7.6 4.4"></path>
</svg>

---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, description, url, language, license, topics, stars, forks, archived, pushedAt, latestRelease } =
  project.data;

// GitHub's colors for the languages most likely to appear here.
const languageColors: Record<string, string> = {
  Java: '#b07219',
  Kotlin: '#a97bff',
  JavaScript: '#f1e05a',
  TypeScript: '#3178c6',
  Python: '#3572a5',
  Astro: '#ff5a03',
  HTML: '#e34c26',
  CSS: '#663399',
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const shownTopics = topics.slice(0, 6);
---

<article class="project">
  <header>
    <Icon name="repo" class="repo-icon" />
    <h3><a href={url} rel="noopener">{name}</a></h3>
    {archived && <span class="badge-archived">Archived</span>}
    {
      latestRelease && (
        <a class="release" href={latestRelease.url} rel="noopener" title={`Released ${formatDate(latestRelease.publishedAt)}`}>
          {latestRelease.tag}
        </a>
      )
    }
  </header>

  {description && <p class="description">{description}</p>}

  {
    shownTopics.length > 0 && (
      <ul class="topics" aria-label="Topics">
        {shownTopics.map((topic) => (
          <li>{topic}</li>
        ))}
      </ul>
    )
  }

  <ul class="stats">
    {
      language && (
        <li>
          <span class="lang-dot" style={`--lang: ${languageColors[language] ?? 'var(--muted)'}`} />
          {language}
        </li>
      )
    }
    <li>
      <a href={url} rel="noopener" aria-label={`${stars} stars`}>
        <Icon name="star" />
        {stars}
      </a>
    </li>
    <li>
      <a href={`${url}/forks`} rel="noopener" aria-label={`${forks} forks`}>
        <Icon name="fork" />
        {forks}
      </a>
    </li>
    {license && license !== 'NOASSERTION' && <li>{license} license</li>}
    <li>Updated {formatDate(pushedAt)}</li>
  </ul>

  <footer class="actions">
    <a class="button secondary small" href={url} rel="noopener">View on GitHub</a>
  </footer>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }
  .project:hover {
    border-color: var(--accent);
  }
  header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* :global because the <svg> is rendered inside the Icon component. */
  .project :global(.repo-icon) {
    width: 1rem;
    height: 1rem;
    fill: var(--muted);
    flex-shrink: 0;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--accent);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .badge-archived,
  .release {
    padding: 0.05rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  .release {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .description {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .topics li {
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 500;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .stats li,
  .stats a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .stats a {
    color: inherit;
    text-decoration: none;
  }
  .stats a:hover {
    color: var(--accent);
  }
  .stats :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
  }
  .lang-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--lang);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }
</style>
